{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://comercioplus-api-zakm.onrender.com/api/$1"
    },
    {
      "source": "/sanctum/(.*)",
      "destination": "https://comercioplus-api-zakm.onrender.com/sanctum/$1"
    },
    {
      "source": "/storage/(.*)",
      "destination": "https://comercioplus-api-zakm.onrender.com/storage/$1"
    },
    {
      "source": "/((?!api/|sanctum/|assets/|favicon.ico$|robots.txt$|manifest.webmanifest$).*)",
      "destination": "/index.html"
    }
  ]
}

